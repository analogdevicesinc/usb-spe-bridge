{
  "problemMatcher": [
    {
      "owner": "gcc-error",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^(.+?):(\\d+):(\\d+)?:?\\s+error:\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      ]
    },
    {
      "owner": "gcc-warning",
      "severity": "warning",
      "pattern": [
        {
          "regexp": "^(.+?):(\\d+):(\\d+)?:?\\s+warning:\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      ]
    },
    {
      "owner": "gcc-note",
      "severity": "notice",
      "pattern": [
        {
          "regexp": "^(.+?):(\\d+):(\\d+)?:?\\s+note:\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      ]
    },
    {
      "owner": "linker-error",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^.*?ld:\\s+(.+)$",
          "message": 1
        }
      ]
    },
    {
      "owner": "undefined-reference",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^(.+?):(\\(.+?\\+.+?\\)):\\s+undefined reference to\\s+[`'\"](.+?)['\"]$",
          "file": 1,
          "location": 2,
          "message": 3
        }
      ]
    }
  ]
}
